@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div class="container-fluid p-0">

    <!-- HEADER -->
    <header class="header-section">
        <div class="header">
            <a href="/" class="logo">AgriHub</a>
            <div class="header-actions">
                <a asp-page="/Login" class="btn  login-btn">
                    Login
                </a>
                <a href="#" class="cart-btn">
                    Cart
                </a>
            </div>
        </div>
    </header>
    <main>
        <section class="hero-section">
            <div class="hero-content">
                <h1>Grow Better. Farm Smarter.</h1>
                <p>Your trusted agriculture marketplace.</p>
                <a asp-page="/Produtcs" class="btn  produtcs-btn">
                   Shop Produtcs
                </a>
                <a href="#farmsolution" class="solution-btn">
                    Farm Solutions
                </a>
            </div>
            <div class="hero-img-box">
                <img src="~/img/hero.jpg" class="hero-img" alt="vegetables" />
            </div>
        </section>

        <section class="featured-section">

            <div class="text">
                <!-- PRODUCTS -->
                <h2 class="secondary-heading">
                    Featured  Products
                </h2>
            </div>
            
                <div class="featured">
                   
                    <div class="featured-content">
                      
                    </div>
                    <h3 class="tertiary-heading">56$</h3>
                    <button class ="productbtn">View product</button>
                </div>

                <div class="featured">
                    <div class="featured-content">
                       
                        
                    </div>
                    <h3 class="tertiary-heading">56$</h3>
                    <button class ="productbtn">View product</button>
                </div>

                <div class="featured">
                 
                    <div class="featured-content">
                       
                    </div>
                    <h3 class="tertiary-heading">56$</h3>
                    <button class="productbtn">View product</button>
                </div>


                <div class="featured">
                   
                    <div class="featured-content">
                        
                         
                    <h3 class="tertiary-heading">56$</h3>
                    <button class="productbtn">View product</button>
                </div>

            </div>
        </section>
    </main>
</div>

    



