@page
@model E_commerce.Pages.LoginModel
@{

    // the title of the page is set to "Login" in the ViewData dictionary,
    // which can be used in the layout or other parts of the page to display
    //  title dynamically.
    ViewData["Title"] = "Login";
}


<<div class="container-fluid p-0">

  
    <header class="header-section">
        <div class="header">
            <a href="/" class="logo">AgriHub</a>
            <div class="header-actions">
                <a asp-page="/Login" class="btn  login-btn">
                    Login
                </a>
                <a href="#" class="cart-btn">
                    Cart
                </a>
            </div>
        </div>
    </header>
    <main>
        <section class="login-section">
            <h2>Welcome to AgriHub</h2>

            <p class="text-muted">
                Sign in to continue shopping.
            </p>

            <form method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3">
                </div>

               
                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-semibold"></label>

                    <div class="input-icon">
                        <img src="~/img/username1.png"
                             class="login-icon"
                             alt="Username" />

                        <input asp-for="Username"
                               class="form-control login-input"
                               placeholder="Enter your username" />
                    </div>

                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>

                    <div class="input-icon">
                        <img src="~/img/password1.png"
                             class="login-icon"
                             alt="Password" />

                        <input asp-for="Password"
                               type="password"
                               class="form-control login-input"
                               placeholder="Enter your password" />
                    </div>

                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">


                    <input class="form-check-input me-2"
                           type="checkbox"
                           id="showPassword" />

                    <label class="form-check-label"
                           for="showPassword">
                        Show password
                    </label>

                </div>

          
                <div class="mb-3">
                    <a href="#"
                       class="small">
                        Forgot password?
                    </a>
                </div>

                <!-- Login Button -->
                <button type="submit"
                        class=" login1-btn">
                    Log In
                </button>

                <hr>

                <!-- Register -->
                <p class="text-center mb-0">
                    Don't have an account?
                    <a asp-page="/Register">
                        Create one
                    </a>
                </p>

            </form>
        </section>

        <script>
                    document.getElementById("showPassword").addEventListener("change", function () {
                        const password = document.getElementById("Password");

                        password.type = this.checked ? "text" : "password";
                    });
        </script>
    </main>


  
   