@page
@model E_commerce.Pages.Shared.RegisterModel
@{

    ViewData["Title"] = "Register";
}


<div class="container-fluid p-0">

    <!-- HEADER -->
    <header class="header-section">
        <div class="header">

            <a asp-page="/Index" class="logo">
                AgriHub
            </a>

            <div class="header-actions">

                <a asp-page="/Login" class="btn login-btn">
                    Login
                </a>

                <a href="#" class="cart-btn">
                    Cart
                </a>

            </div>
        </div>
    </header>


    <!-- MAIN -->
    <main>

        <section class="register-section">

            <h2 class="fw-bold">
                Create Your AgriHub Account
            </h2>

            <p class="text-muted">
                Register to start shopping with AgriHub.
            </p>


            <!-- REGISTER FORM -->
            <form method="post">

                <!-- USERNAME -->
                <div class="form-group mb-3">

                    <label asp-for="Input.Username"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Input.Username"
                           class="form-control"
                           placeholder="Enter your username" />

                    <span asp-validation-for="Input.Username"
                          class="text-danger">
                    </span>

                </div>


                <!-- EMAIL -->
                <div class="form-group mb-3">

                    <label asp-for="Input.Email"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Input.Email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Input.Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- PASSWORD -->
                <div class="form-group mb-4">

                    <label asp-for="Input.Password"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="Input.Password"
                           class="form-control"
                           placeholder="Create a password" />

                    <span asp-validation-for="Input.Password"
                          class="text-danger">
                    </span>

                </div>
                <div class="form-check mb-3">


                    <input class="form-check-input me-2"
                           type="checkbox"
                           id="showPassword" />

                    <label class="form-check-label"
                           for="showPassword">
                        Show password
                    </label>

                </div>


                <!-- SUBMIT -->
                <button type="submit"
                        class="registerbtn">
                    Create Account
                </button>

                <hr />

            </form>

        </section>

    </main>

</div>
<script>
    document.getElementById("showPassword").addEventListener("change", function() {
        const password = document.getElementById("Password");

        password.type = this.checked ? "text" : "password";
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


